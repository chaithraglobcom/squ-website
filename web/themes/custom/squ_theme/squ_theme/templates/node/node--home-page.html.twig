{#
  Home Page landing template.
  Bundle machine name is "home_page" (NOT "landing_page"), so this file must
  be named node--home-page.html.twig or Drupal will never pick it up and
  will silently fall back to Olivero's default node template.

  squ_sections is built in squ_theme_preprocess_node(): it walks the real
  field, field_page_sections, and regroups any consecutive run of
  feature_card / statistics_counter paragraphs into a single wrapper div
  (.squ-tiles / .squ-stats), because those "group" paragraph bundles do not
  exist in this data model - feature_card and statistics_counter are placed
  directly, one at a time, in Page Sections.
#}
<div{{ attributes.addClass('squ-landing-page') }}>
  {% for group in squ_sections %}
    {% if group.bundle == 'feature_card' %}
      <div class="squ-tiles">
        {% for item in group.items %}{{ item }}{% endfor %}
      </div>
    {% elseif group.bundle == 'statistics_counter' %}
      <div class="squ-stats">
        {% for item in group.items %}{{ item }}{% endfor %}
      </div>
    {% else %}
      {% for item in group.items %}{{ item }}{% endfor %}
    {% endif %}
  {% endfor %}
</div>
