{#
Template for News & Events content type.
#}

<article{{ attributes.addClass('news-events') }}>

  {% if content.field_news_events_image %}
    <div class="news-events__image">
      {{ content.field_news_events_image }}
    </div>
  {% endif %}

  <div class="news-events__content">

    {% if label %}
      <h2 class="news-events__title">
        <a href="{{ url }}">{{ label }}</a>
      </h2>
    {% endif %}

    {% if content.field_news_events_category %}
      <div class="news-events__category">
        {{ content.field_news_events_category }}
      </div>
    {% endif %}

    {% if content.field_body %}
      <div class="news-events__body">
        {{ content.field_body }}
      </div>
    {% endif %}

  </div>

</article>