{#
/**
 * @file
 * Shared site header: brand, search, primary nav, language toggle and the
 * slide-in menu drawer.
 *
 * Rendered from squ_theme_preprocess_html() into page_top so every page
 * uses the same header. A menu section is only printed when it has links;
 * the theme leaves it empty while its menu block is disabled.
 *
 * Available variables:
 * - home_url, logo_url
 * - header_links: header-quick-links menu (title/url/active/below), first in
 *   the top row on every page.
 * - menu_items: main menu, after header_links in the top row.
 * - section_items: menu of the Header-region menu block visible on this page
 *   (set via the block's Pages / Content type visibility), in a bar under
 *   the header.
 * - section_label: that block's title, used as the drawer heading.
 * - quick_links: same shape, from the footer-quick-links menu.
 * - search_action: node search URL, or NULL when the search module is off.
 */
#}
{% macro drawer_links(items) %}
  {% import _self as menus %}
  {% for item in items %}
    {% if item.below %}
      <details class="drawer-group"{% if item.active %} open{% endif %}>
        <summary>{{ item.title }}</summary>
        <div class="drawer-sub">
          {% if item.url != '#' %}
            <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.title }}</a>
          {% endif %}
          {{ menus.drawer_links(item.below) }}
        </div>
      </details>
    {% else %}
      <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.title }}</a>
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro primary_nav(items) %}
  <nav class="primary-nav" aria-label="{{ 'Primary'|t }}">
    {% for item in items %}
      {% if item.below %}
        <div class="primary-nav__item has-children">
          <a href="{{ item.url }}"{% if item.active %} class="is-active" aria-current="page"{% endif %}>{{ item.title }}</a>
          <div class="primary-nav__sub">
            {% for child in item.below %}
              <a href="{{ child.url }}"{% if child.active %} class="is-active" aria-current="page"{% endif %}>{{ child.title }}</a>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ item.url }}"{% if item.active %} class="is-active" aria-current="page"{% endif %}>{{ item.title }}</a>
      {% endif %}
    {% endfor %}
  </nav>
{% endmacro %}
{% import _self as menus %}

<header class="site-header squ-site-header{{ section_items ? ' squ-site-header--section' }}" data-squ-header>
  <div class="header-inner">
    <a class="brand" href="{{ home_url }}" rel="home">
      {% if logo_url %}
        <img src="{{ logo_url }}" alt="" width="79" height="98">
      {% endif %}
      <span class="brand-name">
        <span class="brand-ar" lang="ar">جامعة السلطان قابوس</span>
        <span class="brand-en" dir="ltr">Sultan Qaboos University</span>
      </span>
    </a>

    <div class="header-tools">
      <button class="icon-btn" id="squ-search-toggle" type="button" aria-expanded="false" aria-controls="squ-search-panel" aria-label="{{ 'Search'|t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M16 16.5 L20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>

      {% set top_links = header_links|merge(menu_items) %}
      {% if top_links %}
        {{ menus.primary_nav(top_links) }}
      {% endif %}

      <button class="lang-btn" id="squ-lang-toggle" type="button" aria-label="العربية">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
          <ellipse cx="12" cy="12" rx="3.4" ry="8" fill="none" stroke="currentColor" stroke-width="1.5"></ellipse>
          <path d="M4.4 12h15.2M6.2 8.2h11.6M6.2 15.8h11.6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
        </svg>
        <span id="squ-lang-label">AR</span>
      </button>

      <button class="icon-btn" id="squ-menu-toggle" type="button" aria-expanded="false" aria-controls="squ-drawer" aria-label="{{ 'Open menu'|t }}">
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  {% if section_items %}
    <div class="primary-bar">
      {{ menus.primary_nav(section_items) }}
    </div>
  {% endif %}

  <div class="search-panel" id="squ-search-panel" hidden>
    <form id="squ-search-form" role="search"{% if search_action %} action="{{ search_action }}" method="get"{% endif %}>
      <input id="squ-search-input" type="search" name="keys" placeholder="{{ 'Search'|t }}" aria-label="{{ 'Search'|t }}" data-i18n-placeholder="searchPlaceholder">
      <button type="submit" data-i18n="search">{{ 'Search'|t }}</button>
    </form>
  </div>
</header>

<div class="squ-backdrop" id="squ-backdrop" hidden></div>
<aside class="squ-drawer" id="squ-drawer" aria-hidden="true" aria-label="{{ 'Menu'|t }}" inert>
  <div class="drawer-head">
    <strong lang="ar">جامعة السلطان قابوس</strong>
    <button class="drawer-close" id="squ-drawer-close" type="button" aria-label="{{ 'Close menu'|t }}">&times;</button>
  </div>
  <nav aria-label="{{ 'Menu'|t }}">
    {{ menus.drawer_links(header_links) }}
    {{ menus.drawer_links(menu_items) }}
    {% if section_items %}
      <p class="group-label">{{ section_label }}</p>
      {{ menus.drawer_links(section_items) }}
    {% endif %}
    {% if quick_links %}
      <p class="group-label" data-i18n="quickLinks">{{ 'Quick LINKS'|t }}</p>
      {{ menus.drawer_links(quick_links) }}
    {% endif %}
  </nav>
</aside>
