{#
  Section/header menus: outer .squ-menu-panel comes from preprocess attributes.
#}
<div{{ attributes }}>
  {{ title_prefix }}
  {% if label_display == 'visible' %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  <div class="block-inner">
    {{ content }}
  </div>
</div>
