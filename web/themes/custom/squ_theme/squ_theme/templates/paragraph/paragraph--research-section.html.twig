{#
  Paragraph bundle: research_section

  Layout: intro column + card grid (tall cover | featured, then two cards).
#}
{% macro research_card(card, variant) %}
  {% set image_file = card.field_research_image.entity %}
  {% set card_title = card.field_research_card_title.value %}
  {% set card_desc = variant == 'cover' ? '' : card.field_research_card_description.value %}
  {% set card_link = card.field_research_card_link.0.url %}

  <article class="ri-card ri-card--{{ variant }}">
    {% if image_file %}
      <div class="ri-card__media">
        <img class="ri-card__img"
             src="{{ file_url(image_file.uri.value) }}"
             alt="{{ card.field_research_image.alt ?: card_title }}"
             loading="lazy">
      </div>
    {% endif %}

    {% if variant != 'cover' and (card_title or card_desc) %}
      <div class="ri-card__body">
        {% if card_title %}
          <h3 class="ri-card__title">
            {% if card_link %}
              <a href="{{ card_link }}">{{ card_title }}</a>
            {% else %}
              {{ card_title }}
            {% endif %}
          </h3>
        {% endif %}
        {% if card_desc %}
          <div class="ri-card__text">{{ card_desc|raw }}</div>
        {% endif %}
      </div>
    {% endif %}
  </article>
{% endmacro %}

{% import _self as research %}

{% set heading = paragraph.field_research_heading.value %}
{% set description = paragraph.field_research_description.value %}
{% set more_url = paragraph.field_discover_more.0.url %}
{% set more_title = paragraph.field_discover_more.0.title %}

<section class="ri-section">
  <div class="ri-section__inner">
    <div class="ri-grid">

      <div class="ri-left">
        <div class="ri-left__content">
          {% if heading %}
            <h2 class="ri-heading">{{ heading }}</h2>
          {% endif %}
          {% if description %}
            <div class="ri-desc">{{ description|raw }}</div>
          {% endif %}
          {% if more_url %}
            <a href="{{ more_url }}" class="ri-btn">{{ more_title ?: 'Find Out More'|t }}</a>
          {% endif %}
        </div>
      </div>

      <div class="ri-cards">
        <div class="ri-cards__row ri-cards__row--primary">
          {% for item in paragraph.field_research_card %}
            {% set card = item.entity %}
            {% if card and card.status.value and loop.index0 < 2 %}
              {% set variant = loop.first ? 'cover' : 'featured' %}
              {{ research.research_card(card, variant) }}
            {% endif %}
          {% endfor %}
        </div>
        <div class="ri-cards__row ri-cards__row--secondary">
          {% for item in paragraph.field_research_card %}
            {% set card = item.entity %}
            {% if card and card.status.value and loop.index0 >= 2 %}
              {{ research.research_card(card, 'standard') }}
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>
