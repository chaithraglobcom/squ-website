{#
  Bundle: about_squ
  Fields:
    - field_about_background_image (Image)
    - field_about_squ_heading      (Short text)
    - field_about_squ_text         (Long text)
    - field_about_squ_link1        (Link)
    - field_about_squ_link2        (Link)
#}
{% set bg_file  = paragraph.field_about_background_image.entity %}
{% set heading  = paragraph.field_about_squ_heading.value %}
{% set text     = paragraph.field_about_squ_text.value %}
{% set link1_url   = paragraph.field_about_squ_link1.0.url %}
{% set link1_title = paragraph.field_about_squ_link1.0.title %}
{% set link2_url   = paragraph.field_about_squ_link2.0.url %}
{% set link2_title = paragraph.field_about_squ_link2.0.title %}

<section class="about-squ">

  {% if bg_file %}
    <img class="about-squ__bg"
         src="{{ file_url(bg_file.uri.value) }}"
         alt="{{ paragraph.field_about_background_image.alt ?: heading }}"
         loading="lazy">
  {% endif %}

  <div class="about-squ__card">
    {% if heading %}
      <h2 class="about-squ__heading">{{ heading }}</h2>
    {% endif %}

    {% if text %}
      <div class="about-squ__text">{{ text|raw }}</div>
    {% endif %}

    {% if link1_url or link2_url %}
      <div class="about-squ__links">
        {% if link1_url %}
          <a href="{{ link1_url }}" class="about-squ__link">{{ link1_title ?: 'About SQU' }}</a>
        {% endif %}
        {% if link2_url %}
          <a href="{{ link2_url }}" class="about-squ__link">{{ link2_title ?: 'Visit Us' }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>

</section>