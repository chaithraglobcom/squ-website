<?php

/**
 * @file
 * SQU theme hooks: shared header/footer, home page sections, SQU Libraries.
 *
 * The header and footer are added from hook_preprocess_html() (page_top /
 * page_bottom). Header menus are only shown while their menu block is
 * enabled in Block layout, so disabling the block hides that menu section.
 */

use Drupal\block\Entity\Block;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\Entity\Paragraph;

/**
 * Implements hook_theme().
 */
function squ_theme_theme($existing, $type, $theme, $path) {
  return [
    'squ_header' => [
      'variables' => [
        'home_url' => '/',
        'logo_url' => '',
        'header_links' => [],
        'menu_items' => [],
        'section_items' => [],
        'section_label' => '',
        'quick_links' => [],
        'hamburger_menu_items' => [],
        'search_action' => NULL,
      ],
      'template' => 'layout/squ-header',
    ],
    'squ_footer' => [
      'variables' => [
        'year' => '',
        'home_url' => '/',
        'logo_url' => '',
        'quick_links' => [],
        'legal_links' => [],
        'copyright' => '',
      ],
      'template' => 'layout/squ-footer',
    ],
  ];
}

/**
 * Header-region menu blocks that are not the section bar (top row + drawer).
 */
const SQU_THEME_HEADER_NON_SECTION_MENUS = [
  'header-quick-links',
  'main',
  'hamburger-menu',
];

/**
 * The section menu bar for this page.
 *
 * Picks the first (by block weight) enabled menu block in the Header region,
 * other than the top-row menus, whose visibility settings (Pages, Content
 * type, Roles...) allow it on this page. Which section shows where is
 * managed entirely in Block layout.
 *
 * @return array
 *   label: the block's title. items: menu links ([] when none applies).
 */
function _squ_theme_section_menu(CacheableMetadata $cacheability): array {
  $cacheability->addCacheTags(['config:block_list']);
  $blocks = \Drupal::entityTypeManager()->getStorage('block')->loadByProperties([
    'theme' => \Drupal::theme()->getActiveTheme()->getName(),
    'region' => 'header',
  ]);
  uasort($blocks, [Block::class, 'sort']);

  foreach ($blocks as $block) {
    [$provider, $menu_name] = explode(':', $block->getPluginId(), 2) + [1 => ''];
    if ($provider !== 'system_menu_block' || in_array($menu_name, SQU_THEME_HEADER_NON_SECTION_MENUS, TRUE)) {
      continue;
    }
    $access = $block->access('view', NULL, TRUE);
    $cacheability->addCacheableDependency($block)->addCacheableDependency($access);
    if ($access->isAllowed() && ($items = _squ_theme_menu_items($menu_name, $cacheability))) {
      return ['label' => $block->label(), 'items' => $items];
    }
  }
  return ['label' => '', 'items' => []];
}

/**
 * The node of the current canonical node route, or NULL.
 */
function _squ_theme_route_node(): ?NodeInterface {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() !== 'entity.node.canonical') {
    return NULL;
  }
  $node = $route_match->getParameter('node');
  if (is_scalar($node)) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($node);
  }
  return $node instanceof NodeInterface ? $node : NULL;
}

/**
 * Implements hook_preprocess_html().
 */
function squ_theme_preprocess_html(array &$variables) {
  $node = _squ_theme_route_node();
  if ($node && $node->bundle() === 'squ_libraries') {
    $variables['attributes']['class'][] = 'squ-libraries-route';
  }

  $theme_path = \Drupal::service('extension.path.resolver')->getPath('theme', 'squ_theme');
  $logo = $theme_path . '/images/squ-logo.png';
  $logo_url = file_exists(DRUPAL_ROOT . '/' . $logo) ? Url::fromUri('base:' . $logo)->toString() : '';
  $home_url = Url::fromRoute('<front>')->toString();

  $header_cache = (new CacheableMetadata())->addCacheContexts(['url.path']);
  $header_links = _squ_theme_block_menu_items('header-quick-links', $header_cache);
  $menu_items = _squ_theme_block_menu_items('main', $header_cache);
  $section = _squ_theme_section_menu($header_cache);
  $hamburger_menu_items = _squ_theme_menu_items('hamburger-menu', $header_cache);

  $footer_cache = new CacheableMetadata();
  $quick_links = _squ_theme_block_menu_items('footer-quick-links', $footer_cache);
  $legal_links = _squ_theme_block_menu_items('footer', $footer_cache);
  // A "©…" link in the footer menu is the editable copyright line, not a link.
  $copyright = '';
  foreach ($legal_links as $delta => $link) {
    if (str_starts_with(trim($link['title']), '©')) {
      $copyright = $link['title'];
      unset($legal_links[$delta]);
      break;
    }
  }
  $legal_links = array_values($legal_links);

  $search_action = NULL;
  if (\Drupal::service('router.route_provider')->getRoutesByNames(['search.view_node_search'])) {
    $search_action = Url::fromRoute('search.view_node_search')->toString();
  }

  $header = [
    '#theme' => 'squ_header',
    '#home_url' => $home_url,
    '#logo_url' => $logo_url,
    '#header_links' => $header_links,
    '#menu_items' => $menu_items,
    '#section_items' => $section['items'],
    '#section_label' => $section['label'],
    '#quick_links' => $quick_links,
    '#hamburger_menu_items' => $hamburger_menu_items,
    '#search_action' => $search_action,
  ];
  $header_cache->merge($footer_cache)->applyTo($header);
  $variables['page_top']['squ_header'] = $header;

  $footer = [
    '#theme' => 'squ_footer',
    '#year' => date('Y', \Drupal::time()->getRequestTime()),
    '#home_url' => $home_url,
    '#logo_url' => $logo_url,
    '#quick_links' => $quick_links,
    '#legal_links' => $legal_links,
    '#copyright' => $copyright,
  ];
  $footer_cache->applyTo($footer);
  $variables['page_bottom']['squ_footer'] = $footer;
}

/**
 * Menu links, but only while that menu's block is enabled in Block layout.
 *
 * A block counts when it's placed in the active theme and viewable here
 * (enabled + its visibility conditions pass). Otherwise returns [] so the
 * template hides that menu section.
 */
function _squ_theme_block_menu_items(string $menu_name, CacheableMetadata $cacheability): array {
  $cacheability->addCacheTags(['config:block_list']);
  $blocks = \Drupal::entityTypeManager()->getStorage('block')->loadByProperties([
    'theme' => \Drupal::theme()->getActiveTheme()->getName(),
    'plugin' => 'system_menu_block:' . $menu_name,
  ]);
  foreach ($blocks as $block) {
    $access = $block->access('view', NULL, TRUE);
    $cacheability->addCacheableDependency($block)->addCacheableDependency($access);
    if ($access->isAllowed()) {
      return _squ_theme_menu_items($menu_name, $cacheability);
    }
  }
  return [];
}

/**
 * Enabled, accessible links of a menu as nested title/url/active/below arrays.
 */
function _squ_theme_menu_items(string $menu_name, CacheableMetadata $cacheability): array {
  $cacheability->addCacheTags(['config:system.menu.' . $menu_name]);
  $cacheability->addCacheContexts(['user.permissions', 'route.menu_active_trails:' . $menu_name]);

  $menu_tree = \Drupal::menuTree();
  $parameters = (new MenuTreeParameters())
    ->onlyEnabledLinks()
    ->setMaxDepth(3)
    ->setActiveTrail(\Drupal::service('menu.active_trail')->getActiveTrailIds($menu_name));
  $tree = $menu_tree->transform($menu_tree->load($menu_name, $parameters), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);
  return _squ_theme_menu_tree_items($tree, $cacheability);
}

/**
 * Flattens a loaded menu tree into plain arrays for Twig.
 */
function _squ_theme_menu_tree_items(array $tree, CacheableMetadata $cacheability): array {
  $items = [];
  foreach ($tree as $element) {
    if (isset($element->access)) {
      $cacheability->addCacheableDependency($element->access);
      if (!$element->access->isAllowed()) {
        continue;
      }
    }
    $link = $element->link;
    $url = $link->getUrlObject();
    $nolink = $url->isRouted() && in_array($url->getRouteName(), ['<none>', '<nolink>', '<button>'], TRUE);

    $items[] = [
      'title' => (string) $link->getTitle(),
      'url' => $nolink ? '#' : ($url->toString() ?: '#'),
      'active' => (bool) $element->inActiveTrail,
      'below' => $element->subtree ? _squ_theme_menu_tree_items($element->subtree, $cacheability) : [],
    ];
  }
  return $items;
}

/**
 * Implements hook_preprocess_page().
 */
function squ_theme_preprocess_page(array &$variables): void {
  $node = _squ_theme_route_node();
  if ($node && $node->bundle() === 'squ_libraries') {
    $variables['#attached']['library'][] = 'squ_theme/squ_libraries';
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * Home Page: builds $variables['squ_sections'] for node--home-page.html.twig.
 * Consecutive feature_card / statistics_counter paragraphs in
 * field_page_sections are grouped so the template can wrap each run in one
 * .squ-tiles / .squ-stats row.
 */
function squ_theme_preprocess_node(array &$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'home_page' || !$node->hasField('field_page_sections') || $node->get('field_page_sections')->isEmpty()) {
    return;
  }

  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('paragraph');
  $row_bundles = ['feature_card', 'statistics_counter'];

  $groups = [];
  foreach ($node->get('field_page_sections')->referencedEntities() as $paragraph) {
    $bundle = $paragraph->bundle();
    $render = $view_builder->view($paragraph, 'default');
    $last = array_key_last($groups);

    if (in_array($bundle, $row_bundles, TRUE) && $last !== NULL && $groups[$last]['bundle'] === $bundle) {
      $groups[$last]['items'][] = $render;
      continue;
    }
    $groups[] = ['bundle' => $bundle, 'items' => [$render]];
  }

  $variables['squ_sections'] = $groups;
}

/**
 * Implements hook_preprocess_node() for squ_libraries.
 */
function squ_theme_preprocess_node__squ_libraries(array &$variables): void {
  $variables['libraries_breadcrumb'] = [
    [
      'title' => (string) t('Home'),
      'url' => Url::fromRoute('<front>')->toString(),
      'current' => FALSE,
    ],
    [
      'title' => $variables['node']->label(),
      'url' => NULL,
      'current' => TRUE,
    ],
  ];
}

/**
 * Parent squ_libraries node of a paragraph, or NULL.
 */
function _squ_theme_libraries_parent(Paragraph $paragraph): ?NodeInterface {
  $parent = $paragraph->getParentEntity();
  return $parent instanceof NodeInterface && $parent->bundle() === 'squ_libraries' ? $parent : NULL;
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 */
function squ_theme_theme_suggestions_paragraph_alter(array &$suggestions, array $variables): void {
  $paragraph = $variables['elements']['#paragraph'] ?? NULL;
  if (!$paragraph || !_squ_theme_libraries_parent($paragraph)) {
    return;
  }
  if (in_array($paragraph->bundle(), ['hero_banner', 'research_card'], TRUE)) {
    $suggestions[] = 'paragraph__' . $paragraph->bundle() . '__libraries';
  }
}

/**
 * Implements hook_preprocess_paragraph().
 *
 * Research cards on squ_libraries nodes get a quick / service / resource
 * layout, based on which node field references them.
 */
function squ_theme_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  if ($paragraph->bundle() !== 'research_card' || !($node = _squ_theme_libraries_parent($paragraph))) {
    return;
  }

  $map = [
    'field_cards' => 'quick',
    'field_e_resources' => 'resource',
    'field_library_services' => 'service',
  ];
  $variables['libraries_card_type'] = 'service';
  foreach ($map as $field_name => $type) {
    if (!$node->hasField($field_name)) {
      continue;
    }
    foreach ($node->get($field_name) as $item) {
      if ((int) $item->target_id === (int) $paragraph->id()) {
        $variables['libraries_card_type'] = $type;
        return;
      }
    }
  }
}
