<?php

/**
 * @file
 * SQU theme: home page sections, SQU Libraries, minimal layout hooks.
 *
 * Header, footer, and menus are rendered via block regions and Twig
 * (templates/layout/page.html.twig). Block visibility controls section menus.
 */

use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\Entity\Paragraph;

/**
 * Section bar menus (Block layout → Header: Section menu region).
 */
const SQU_THEME_SECTION_MENUS = [
  'deanship-menu',
  'student-department-menu',
  'squh-menu',
  'undergraduate-menu',
  'postgraduate-menu',
  'about-squ',
  'study-at-squ',
  'news-events',
  'squ-libraries',
  'research-innovation',
];

/**
 * The node of the current canonical node route, or NULL.
 */
function _squ_theme_route_node(): ?NodeInterface {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() !== 'entity.node.canonical') {
    return NULL;
  }
  $node = $route_match->getParameter('node');
  if (is_scalar($node)) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($node);
  }
  return $node instanceof NodeInterface ? $node : NULL;
}

/**
 * Implements hook_preprocess_html().
 */
function squ_theme_preprocess_html(array &$variables): void {
  $node = _squ_theme_route_node();
  if ($node && $node->bundle() === 'squ_libraries') {
    $variables['attributes']['class'][] = 'squ-libraries-route';
  }
}

/**
 * Implements hook_preprocess_page().
 */
function squ_theme_preprocess_page(array &$variables): void {
  $node = _squ_theme_route_node();
  if ($node && $node->bundle() === 'squ_libraries') {
    $variables['#attached']['library'][] = 'squ_theme/squ_libraries';
  }

  $variables['squ_search_action'] = NULL;
  if (\Drupal::service('router.route_provider')->getRoutesByNames(['search.view_node_search'])) {
    $variables['squ_search_action'] = Url::fromRoute('search.view_node_search')->toString();
  }
}

/**
 * Implements hook_theme_suggestions_menu_alter().
 */
function squ_theme_theme_suggestions_menu_alter(array &$suggestions, array $variables): void {
  $menu_name = $variables['menu_name'] ?? '';
  if ($menu_name && in_array($menu_name, SQU_THEME_SECTION_MENUS, TRUE)) {
    $suggestions[] = 'menu__section';
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * Home Page: builds $variables['squ_sections'] for node--home-page.html.twig.
 */
function squ_theme_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  if ($node->bundle() !== 'home_page' || !$node->hasField('field_page_sections') || $node->get('field_page_sections')->isEmpty()) {
    return;
  }

  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('paragraph');
  $row_bundles = ['feature_card', 'statistics_counter'];

  $groups = [];
  foreach ($node->get('field_page_sections')->referencedEntities() as $paragraph) {
    $bundle = $paragraph->bundle();
    $render = $view_builder->view($paragraph, 'default');
    $last = array_key_last($groups);

    if (in_array($bundle, $row_bundles, TRUE) && $last !== NULL && $groups[$last]['bundle'] === $bundle) {
      $groups[$last]['items'][] = $render;
      continue;
    }
    $groups[] = ['bundle' => $bundle, 'items' => [$render]];
  }

  $variables['squ_sections'] = $groups;
}

/**
 * Implements hook_preprocess_node() for squ_libraries.
 */
function squ_theme_preprocess_node__squ_libraries(array &$variables): void {
  $variables['libraries_breadcrumb'] = [
    [
      'title' => (string) t('Home'),
      'url' => Url::fromRoute('<front>')->toString(),
      'current' => FALSE,
    ],
    [
      'title' => $variables['node']->label(),
      'url' => NULL,
      'current' => TRUE,
    ],
  ];
}

/**
 * Parent squ_libraries node of a paragraph, or NULL.
 */
function _squ_theme_libraries_parent(Paragraph $paragraph): ?NodeInterface {
  $parent = $paragraph->getParentEntity();
  return $parent instanceof NodeInterface && $parent->bundle() === 'squ_libraries' ? $parent : NULL;
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 */
function squ_theme_theme_suggestions_paragraph_alter(array &$suggestions, array $variables): void {
  $paragraph = $variables['elements']['#paragraph'] ?? NULL;
  if (!$paragraph || !_squ_theme_libraries_parent($paragraph)) {
    return;
  }
  if (in_array($paragraph->bundle(), ['hero_banner', 'research_card'], TRUE)) {
    $suggestions[] = 'paragraph__' . $paragraph->bundle() . '__libraries';
  }
}

/**
 * Implements hook_preprocess_paragraph().
 */
function squ_theme_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  if ($paragraph->bundle() !== 'research_card' || !($node = _squ_theme_libraries_parent($paragraph))) {
    return;
  }

  $map = [
    'field_cards' => 'quick',
    'field_e_resources' => 'resource',
    'field_library_services' => 'service',
  ];
  $variables['libraries_card_type'] = 'service';
  foreach ($map as $field_name => $type) {
    if (!$node->hasField($field_name)) {
      continue;
    }
    foreach ($node->get($field_name) as $item) {
      if ((int) $item->target_id === (int) $paragraph->id()) {
        $variables['libraries_card_type'] = $type;
        return;
      }
    }
  }
}
