{#
/**
 * @file
 * Landing page (home_page) — page-level HTML defined here.
 *
 * field_page_sections paragraphs: rows (.squ-tiles, .squ-stats) + blocks.
 * Inner section markup: templates/paragraph/paragraph--*.html.twig
 */
#}
<article{{ attributes.addClass('squ-landing-page', 'node--type-home-page') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <div class="squ-landing-page__body">
    {% if node.field_page_sections.value %}
      <div class="squ-landing-page__sections squ-landing-sections">
        {% set row_bundles = ['feature_card', 'statistics_counter'] %}
        {% set open_row = '' %}

        {% for delta in 0..(node.field_page_sections|length - 1) %}
          {% if content.field_page_sections[delta] is defined %}
            {% set paragraph = node.field_page_sections[delta].entity %}
            {% set bundle = paragraph.bundle %}
            {% set render = content.field_page_sections[delta] %}

            {% if bundle in row_bundles %}
              {% if open_row != bundle %}
                {% if open_row != '' %}
                  </div>
                {% endif %}
                <div class="{{ bundle == 'feature_card' ? 'squ-tiles' : 'squ-stats' }}">
                {% set open_row = bundle %}
              {% endif %}
              {{ render }}
            {% else %}
              {% if open_row != '' %}
                </div>
                {% set open_row = '' %}
              {% endif %}
              <div class="squ-landing-page__block squ-landing-page__block--{{ bundle|clean_class }}">
                {{ render }}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if open_row != '' %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {{ content|without('field_page_sections', 'links') }}
</article>
