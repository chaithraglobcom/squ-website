{#
  SQU Libraries node — main content only. Global header/footer come from the
  page layout (squ-header + squ_footer). Section menu: squ-libraries (see
  squ_theme_get_section_menu_name() in squ_theme.theme).
#}
<article{{ attributes.addClass('squ-libraries-standalone') }}>

  {% if libraries_breadcrumb %}
    <section class="breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
      <div class="container">
        <ol>
          {% for crumb in libraries_breadcrumb %}
            <li>
              {% if crumb.current %}
                <span aria-current="page">{{ crumb.title }}</span>
              {% else %}
                <a href="{{ crumb.url }}">{{ crumb.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      </div>
    </section>
  {% endif %}

  {{ content.field_banner|without('label') }}

  {% if content.field_simpleblock %}
    <section class="opening-hours" aria-labelledby="libraries-hours-title">
      <div class="container">
        <div class="ornament" aria-hidden="true"><span></span></div>
        <div id="libraries-hours-title" class="opening-hours__content">
          {{ content.field_simpleblock|without('label') }}
        </div>
      </div>
    </section>
  {% endif %}

  {% if content.field_cards %}
    <section class="quick-links" aria-label="{{ 'Quick access'|t }}">
      <div class="container">
        <div class="card-grid libraries-field-grid">
          {{ content.field_cards|without('label') }}
        </div>
      </div>
    </section>
  {% endif %}

  {% if content.field_library_services %}
    <section class="library-services" aria-labelledby="libraries-services-title">
      <div class="container">
        <h2 class="section-title" id="libraries-services-title">{{ 'Library Services'|t }}</h2>
        <div class="ornament" aria-hidden="true"><span></span></div>
        <div class="service-grid libraries-field-grid">
          {{ content.field_library_services|without('label') }}
        </div>
      </div>
    </section>
  {% endif %}

  {% if content.field_e_resources %}
    <section class="featured-resources" aria-labelledby="libraries-resources-title">
      <div class="container">
        <h2 class="section-title" id="libraries-resources-title">{{ 'Featured E-Resources'|t }}</h2>
        <div class="ornament" aria-hidden="true"><span></span></div>
        <div class="resource-grid libraries-field-grid">
          {{ content.field_e_resources|without('label') }}
        </div>
      </div>
    </section>
  {% endif %}

  {% if content.field_upcoming_events %}
    <div class="page-split">
      <section class="events" aria-labelledby="libraries-events-title">
        <h2 class="section-title" id="libraries-events-title">
          {{ 'Upcoming Events'|t }}
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
        </h2>
        <div class="ornament" aria-hidden="true"><span></span></div>
        {{ content.field_upcoming_events|without('label') }}
      </section>
    </div>
  {% endif %}

  {% if content.field_stay_in_touch %}
    <section class="stay-in-touch" aria-labelledby="libraries-touch-title">
      <div class="container">
        <h2 class="section-title" id="libraries-touch-title">{{ 'Stay in Touch'|t }}</h2>
        <div class="ornament" aria-hidden="true"><span></span></div>
        <div class="social-links stay-in-touch__content">
          {{ content.field_stay_in_touch|without('label') }}
        </div>
      </div>
    </section>
  {% endif %}

</article>
