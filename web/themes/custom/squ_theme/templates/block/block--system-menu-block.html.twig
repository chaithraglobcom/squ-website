{#
  Section menus in header_section (visibility per page in Block layout).
#}
<div{{ attributes }}>
  {{ title_prefix }}
  {% if label_display == 'visible' %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  <div class="block-inner">
    {{ content }}
  </div>
</div>
