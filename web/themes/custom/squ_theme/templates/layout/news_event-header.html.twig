{#
/**
 * @file
 * Shared site header: brand, search, primary nav, language toggle and the
 * slide-in menu drawer.
 *
 * Rendered from squ_theme_preprocess_html() into page_top so every page
 * uses the same header. A menu section is only printed when it has links;
 * the theme leaves it empty while its menu block is disabled.
 *
 * Available variables:
 * - home_url, logo_url
 * - header_links: header-quick-links menu (title/url/active/below), first in
 *   the top row on every page.
 * - menu_items: main menu, after header_links in the top row.
 * - section_items: menu of the Header-region menu block visible on this page
 *   (set via the block's Pages / Content type visibility), in a bar under
 *   the header.
 * - section_label: that block's title, used as the drawer heading.
 * - quick_links: same shape, from the footer-quick-links menu.
 * - search_action: node search URL, or NULL when the search module is off.
 */
#}
<header class="header">
<div class="brand-row">
<img class="anwaar-logo" src="data:image/png;base64," alt="Anwaar">
<img class="squ-banner" src="data:image/png;base64," alt="SQU">
</div>

  <div class="news-events-menu">
    
  <div class="news-events-menu">
    {{ news_events_menu }}
  </div>
  </div>
</header>