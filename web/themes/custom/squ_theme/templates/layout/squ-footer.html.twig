{#
/**
 * @file
 * Shared site footer. Styles: footer.css
 *
 * Variables: year, home_url, logo_url, quick_links, legal_links, copyright.
 */
#}
{% macro menu_link(item) %}
  <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.title }}</a>
{% endmacro %}
{% import _self as footer %}

{# Quick links ka order (row by row: 3 columns) #}
{% set quick_order = [
  'admissions', 'careers', 'research & innovations',
  'libraries', 'conferences', 'news & events',
  'site map', 'tenders', 'contact & help'
] %}

<footer class="squ-footer squ-chrome-footer">

  <div class="squ-footer__pattern" aria-hidden="true"></div>

  <div class="squ-footer__main">
    <div class="squ-footer__inner">

      {# LEFT: logo + name (Arabic + English) + 4 icon buttons #}
      <div class="squ-footer__brand">
        {% if logo_url %}
          <a href="{{ home_url }}" rel="home" class="squ-footer__logo">
            <img src="{{ logo_url }}" alt="Sultan Qaboos University">
          </a>
        {% endif %}

        <div class="squ-footer__name">
          <span class="squ-footer__name-ar" lang="ar" dir="rtl">جامعة السلطان قابوس</span>
          <span class="squ-footer__name-en" lang="en" dir="ltr">Sultan Qaboos University</span>
        </div>

        <div class="squ-footer__icons">
          <a class="squ-footer__icon" href="https://www.instagram.com/squ_oman/" aria-label="Media" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5"/>
              <path d="M10.2 8.8 15.4 12l-5.2 3.2z"/>
            </svg>
          </a>
          <a class="squ-footer__icon" href="https://www.squ.edu.om/" aria-label="{{ 'Sultan Qaboos University website'|t }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5"/>
              <ellipse cx="12" cy="12" rx="3.4" ry="8.5"/>
              <path d="M3.5 12h17M4.6 8h14.8M4.6 16h14.8"/>
            </svg>
          </a>
          <a class="squ-footer__icon" href="https://www.linkedin.com/school/sultan-qaboos-university/" aria-label="Community" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="9" cy="8.5" r="2.7"/>
              <circle cx="16.5" cy="9.5" r="2.1"/>
              <path d="M4 18.5c.5-3 2.4-4.5 5-4.5s4.5 1.5 5 4.5M14.5 14.4c2.2-.4 4.2.7 5 3.6"/>
            </svg>
          </a>
          <a class="squ-footer__icon" href="https://www.squ.edu.om/" aria-label="{{ 'Contact and help'|t }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13v-1a7 7 0 0 1 14 0v1"/>
              <rect x="3.8" y="12.5" width="3.6" height="6" rx="1.5"/>
              <rect x="16.6" y="12.5" width="3.6" height="6" rx="1.5"/>
              <path d="M18.4 18.5c0 1.6-1.6 2.5-4.2 2.5"/>
            </svg>
          </a>
        </div>
      </div>

      {# RIGHT: quick links #}
      {% if quick_links %}
        <div class="squ-footer__quick">
          <h2 class="squ-footer__quick-title">{{ quick_title|default('Quick Links'|t) }}</h2>
          <ul class="squ-footer__quick-list">

            {# 1) Pehle design wale order me #}
            {% for name in quick_order %}
              {% for item in quick_links %}
                {% if item.title|striptags|replace({'&amp;': '&'})|trim|lower == name %}
                  <li>{{ footer.menu_link(item) }}</li>
                {% endif %}
              {% endfor %}
            {% endfor %}

            {# 2) Jo links list me nahi hain (naye add kiye) wo neeche aayenge #}
            {% for item in quick_links %}
              {% if item.title|striptags|replace({'&amp;': '&'})|trim|lower not in quick_order %}
                <li>{{ footer.menu_link(item) }}</li>
              {% endif %}
            {% endfor %}

          </ul>
        </div>
      {% endif %}

    </div>
  </div>

  {# BOTTOM BAR #}
  <div class="squ-footer__bar">
    <div class="squ-footer__bar-inner">

      <p class="squ-footer__copyright">
        {% if copyright %}
          {{ copyright }}
        {% else %}
          <svg class="squ-footer__c" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M15 9.5a3.5 3.5 0 1 0 0 5"/>
          </svg>
          <span>{{ year }} Sultan Qaboos University. All Rights Reserved.</span>
        {% endif %}
      </p>

      {% if legal_links %}
        <nav class="squ-footer__legal" aria-label="{{ 'Legal'|t }}">
          <ul>
            {% for item in legal_links %}
              <li>{{ footer.menu_link(item) }}</li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

    </div>
  </div>

</footer>