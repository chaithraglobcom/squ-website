{#
/**
 * @file
 * SQU page layout: block regions for header, breadcrumb, content, footer.
 */
#}
<div id="page-wrapper" class="page-wrapper squ-page-wrapper">
  <div id="page" class="squ-page">

    {% set has_section = page.header_section|render|trim is not empty %}
    <header class="site-header squ-site-header{{ has_section ? ' squ-site-header--section' }}" data-squ-header>
      <div class="header-inner">
        {% if page.header_brand %}
          <div class="squ-region squ-region--header-brand">
            {{ page.header_brand }}
          </div>
        {% else %}
          {% include '@squ_theme/includes/squ-brand.html.twig' %}
        {% endif %}

        <div class="header-tools">
          {% include '@squ_theme/includes/squ-search.html.twig' with { search_action: squ_search_action|default(null) } only %}
          {% if page.header_tools %}
            <div class="squ-region squ-region--header-tools">
              {{ page.header_tools }}
            </div>
          {% endif %}
          {% include '@squ_theme/includes/squ-header-controls.html.twig' %}
        </div>
      </div>

      {% if has_section %}
        <div class="squ-region squ-region--header-section primary-bar">
          {{ page.header_section }}
        </div>
      {% endif %}
    </header>

    {% include '@squ_theme/includes/squ-drawer.html.twig' with { drawer_menu: page.header_drawer } only %}

    {% if page.highlighted %}
      <div class="squ-region squ-region--highlighted">
        {{ page.highlighted }}
      </div>
    {% endif %}

    <div class="squ-main layout-main-wrapper">
      {% if page.breadcrumb %}
        <div class="squ-breadcrumb-wrap container">
          {{ page.breadcrumb }}
        </div>
      {% endif %}

      <div class="squ-content-layout container">
        {% if page.sidebar_first %}
          <div class="squ-layout-with-sidebar">
            <main id="main-content" class="squ-main-content site-main" tabindex="-1">
              {{ page.content }}
            </main>
            <aside class="squ-sidebar layout-sidebar-first" role="complementary">
              {{ page.sidebar_first }}
            </aside>
          </div>
        {% else %}
          <main id="main-content" class="squ-main-content site-main" tabindex="-1">
            {{ page.content }}
          </main>
        {% endif %}
      </div>
    </div>

    {% if page.footer_brand or page.footer or page.footer_bar %}
      <footer class="squ-footer squ-chrome-footer">
        <div class="squ-footer__pattern" aria-hidden="true"></div>
        {% if page.footer_brand or page.footer %}
          <div class="squ-footer__main">
            <div class="squ-footer__inner">
              {% if page.footer_brand %}
                {{ page.footer_brand }}
              {% endif %}
              {% if page.footer %}
                <div class="squ-footer__blocks">
                  {{ page.footer }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
        {% if page.footer_bar %}
          <div class="squ-footer__bar">
            <div class="squ-footer__bar-inner squ-footer__bar-blocks">
              {{ page.footer_bar }}
            </div>
          </div>
        {% endif %}
      </footer>
    {% endif %}

    {% if page.secondary_menu %}
      <div class="visually-hidden">
        {{ page.secondary_menu }}
      </div>
    {% endif %}

  </div>
</div>
