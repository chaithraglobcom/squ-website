{#
  Hero banner. Real fields on this bundle (hero_banner) are:
  field_background_image, field_heading, field_quote_text, field_quote_author.
  There is no field_title and no field_eyebrow - those were leftover names
  from a different project's content model, and would silently print nothing.

  The background is the uploaded "Background image"; if none is uploaded,
  css/hero.css falls back to images/hero-default.jpg.
  Reads the field values directly (not content.field_x), so it does not
  depend on the paragraph's "Manage display" settings.
#}
{% set bg = paragraph.field_background_image.entity.fileuri %}
<section class="squ-hero"{% if bg %} style="background-image:url('{{ file_url(bg) }}')"{% endif %}>
  <div class="squ-hero__card">
    {% if paragraph.field_heading.value %}
      <h1 class="squ-hero__title">{{ paragraph.field_heading.value }}</h1>
    {% endif %}
    {% if paragraph.field_quote_text.value %}
      <div class="squ-hero__quote">{{ paragraph.field_quote_text.processed }}</div>
    {% endif %}
    {% if paragraph.field_quote_author.value %}
      <div class="squ-hero__attribution">{{ paragraph.field_quote_author.value }}</div>
    {% endif %}
  </div>
</section>
