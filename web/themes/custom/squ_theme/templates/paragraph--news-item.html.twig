{#
  One news teaser row. Bundle: news_item.
  Fields: field_news_title, field_news_date, field_news_description.
  There was no template at all for this bundle before, so items referenced
  in field_news_items were falling back to Drupal's unstyled default markup.
#}
<article class="squ-news__item">
  <h3 class="squ-news__item-title">{{ content.field_news_title }}</h3>
  <div class="squ-news__item-date">{{ content.field_news_date }}</div>
  <div class="squ-news__item-desc">{{ content.field_news_description }}</div>
</article>
