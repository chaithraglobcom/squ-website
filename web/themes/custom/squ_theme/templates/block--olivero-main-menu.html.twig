{#
  The real block ID is "olivero_main_menu" (plugin system_menu_block:main) -
  Drupal's suggestion is block--olivero-main-menu.html.twig. The previous
  file, block--header-menu-level1.html.twig, doesn't match any block ID and
  was never rendered, so menu-overlay.js's
  document.querySelector('.squ-menu-panel[data-level="1"]') always came back
  null and the hamburger mega-menu silently did nothing.
#}
<div class="squ-menu-panel" data-level="1">
  <div class="block-inner">
    {{ content }}
  </div>
</div>
