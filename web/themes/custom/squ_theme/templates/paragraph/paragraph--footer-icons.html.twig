{#
  One social / footer icon link. Bundle: footer_icons.
  Fields: field_footer_icons (image/svg), field_footer_icon_link (link).
#}
{% set link = paragraph.field_footer_icon_link.0 %}
{% if link.url %}
  <a class="squ-footer__icon" href="{{ link.url }}" aria-label="{{ link.title|default('Link'|t)|striptags }}"{% if link.url.external %} target="_blank" rel="noopener"{% endif %}>
    {{ content.field_footer_icons }}
  </a>
{% else %}
  <span class="squ-footer__icon">{{ content.field_footer_icons }}</span>
{% endif %}
