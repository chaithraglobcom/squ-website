{#
  One "Postgraduate / Undergraduate / International" style tile.
  Bundle: feature_card. Fields: field_image, field_label, field_link.
  Placed directly (one per paragraph) in Page Sections; consecutive
  feature_card paragraphs are wrapped in a shared .squ-tiles row by
  squ_theme_preprocess_node() / node--home-page.html.twig.
#}
{% set url = paragraph.field_link.0.url %}
<{{ url ? 'a' : 'div' }} class="squ-tile"{% if url %} href="{{ url }}"{% endif %}>
  <div class="squ-tile__bg">{{ content.field_image }}</div>
  <span>{{ content.field_label }}</span>
</{{ url ? 'a' : 'div' }}>
