{#
  Hero for squ_libraries nodes — page-hero layout from the libraries design.
  field_quote_text: optional catalog search / intro HTML (formatted text).
  field_quote_author: optional hero action links (formatted text).
#}
{% set bg = paragraph.field_background_image.entity.fileuri %}
<section class="page-hero"{% if bg %} style="background-image: linear-gradient(rgba(20, 28, 38, 0.28), rgba(20, 28, 38, 0.28)), url('{{ file_url(bg) }}');"{% endif %}>
  <div class="hero-inner">
    {% if paragraph.field_heading.value %}
      <h1>{{ paragraph.field_heading.value }}</h1>
    {% endif %}
    {% if paragraph.field_quote_text.value %}
      {{ paragraph.field_quote_text.processed }}
    {% endif %}
    {% if paragraph.field_quote_author.value %}
      <div class="hero-actions">
        {{ paragraph.field_quote_author.processed }}
      </div>
    {% endif %}
  </div>
</section>
