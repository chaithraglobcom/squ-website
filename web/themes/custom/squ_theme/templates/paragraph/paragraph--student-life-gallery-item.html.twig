{#
  One tile inside the Students Life gallery. Bundle: student_life_gallery_item.
  Fields: field_images, field_image_caption.
  First tile in the grid gets .is-large to match the bigger "Students Life"
  tile in the reference design (grid-column/row span already defined in
  homepage.css) - there's no dedicated "featured" field in this data model.
#}
<div class="squ-gallery__tile{{ loop.first ? ' is-large' : '' }}">
  <div class="squ-gallery__tile-bg">{{ content.field_images }}</div>
  <span>{{ content.field_image_caption }}</span>
</div>
