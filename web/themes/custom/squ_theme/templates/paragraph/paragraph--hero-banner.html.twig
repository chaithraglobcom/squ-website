{#
  Hero banner — home landing (.squ-hero) or libraries page (.page-hero).
#}
{% set parent = paragraph.getParentEntity() %}
{% set is_libraries = parent and parent.bundle == 'squ_libraries' %}
{% set bg = paragraph.field_background_image.entity.fileuri %}

{% if is_libraries %}
  <section class="page-hero"{% if bg %} style="background-image: linear-gradient(rgba(20, 28, 38, 0.28), rgba(20, 28, 38, 0.28)), url('{{ file_url(bg) }}');"{% endif %}>
    <div class="hero-inner">
      {% if paragraph.field_heading.value %}
        <h1>{{ paragraph.field_heading.value }}</h1>
      {% endif %}
      {% if paragraph.field_quote_text.value %}
        {{ paragraph.field_quote_text.processed }}
      {% endif %}
      {% if paragraph.field_quote_author.value %}
        <div class="hero-actions">
          {{ paragraph.field_quote_author.processed }}
        </div>
      {% endif %}
    </div>
  </section>
{% else %}
  <section class="squ-hero"{% if bg %} style="background-image:url('{{ file_url(bg) }}')"{% endif %}>
    <div class="squ-hero__card">
      {% if paragraph.field_heading.value %}
        <span class="squ-hero__title">{{ paragraph.field_heading.value }}</span>
      {% endif %}
      {% if paragraph.field_heading1.value %}
        <span class="squ-hero__title1">{{ paragraph.field_heading1.value }}</span>
      {% endif %}
      {% if paragraph.field_quote_text.value %}
        <div class="squ-hero__quote">{{ paragraph.field_quote_text.value }}</div>
      {% endif %}
      {% if paragraph.field_quote_author.value %}
        <div class="squ-hero__attribution">{{ paragraph.field_quote_author.value }}</div>
      {% endif %}
    </div>
  </section>
{% endif %}
