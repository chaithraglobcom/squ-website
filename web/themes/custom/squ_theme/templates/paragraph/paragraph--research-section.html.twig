<section class="squ-research">
  <div class="squ-research__intro-col">
    <h2 class="squ-research__heading">{{ content.field_research_heading }}</h2>
    {% if content.field_research_description %}
      <div class="squ-research__intro">{{ content.field_research_description }}</div>
    {% endif %}
    {% if content.field_discover_more %}
      <div class="squ-research__more">{{ content.field_discover_more }}</div>
    {% endif %}
  </div>
  <div class="squ-research__cards">{{ content.field_research_card }}</div>
</section>