{#
  Paragraph bundle: student_life_section
  File: paragraph--student-life-section.html.twig

  Fields:
    - field_student_life_title  (Short text, single)
    - field_tiles               (Entity reference revisions -> student_life_gallery_item, unlimited)

  Child paragraph (student_life_gallery_item) fields:
    - field_images              (Image, single)
    - field_image_caption       (Short text, single)
#}
<section class="squ-gallery">

  {% if paragraph.field_student_life_title.value %}
    <h2 class="squ-gallery__heading">{{ paragraph.field_student_life_title.value }}</h2>
  {% endif %}

  <div class="squ-gallery__grid">
    {% for item in paragraph.field_tiles %}
      {% set tile = item.entity %}
      {% if tile %}
        {% set image_file = tile.field_images.entity %}
        {% set caption    = tile.field_image_caption.value %}

        <div class="squ-gallery__tile">

          {% if image_file %}
            <div class="squ-gallery__tile-bg">
              <img src="{{ file_url(image_file.uri.value) }}"
                   alt="{{ tile.field_images.alt ?: caption }}"
                   loading="lazy">
            </div>
          {% endif %}

          {% if caption %}
            <div class="squ-gallery__label">{{ caption }}</div>
          {% endif %}

        </div>
      {% endif %}
    {% endfor %}
  </div>

</section>