{#
  One stat (e.g. "8841 / Students"). Bundle: statistics_counter.
  Fields: field_statistics_number, field_statistics_label.
  Consecutive statistics_counter paragraphs are wrapped in a shared
  .squ-stats row by node--home-page.html.twig.
#}
<div class="squ-stat">
  <div class="squ-stat__number">{{ content.field_statistics_number }}</div>
  <div class="squ-stat__label">{{ content.field_statistics_label }}</div>
</div>
