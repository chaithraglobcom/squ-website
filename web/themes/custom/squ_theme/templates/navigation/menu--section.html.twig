{#
  Section bar menus (deanship, libraries, etc.) — one block visible per page via Block layout.
#}
{% import _self as menus %}
{% if items %}
  <nav class="primary-nav primary-nav--section" aria-label="{{ 'Section'|t }}">
    {{ menus.links(items) }}
  </nav>
{% endif %}

{% macro links(items) %}
  {% import _self as menus %}
  {% for item in items %}
    {% if item.below %}
      <div class="primary-nav__item has-children">
        <a href="{{ item.url }}"{% if item.in_active_trail %} class="is-active" aria-current="page"{% endif %}>{{ item.title }}</a>
        <div class="primary-nav__sub">
          {% for child in item.below %}
            <a href="{{ child.url }}"{% if child.in_active_trail %} class="is-active" aria-current="page"{% endif %}>{{ child.title }}</a>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <a href="{{ item.url }}"{% if item.in_active_trail %} class="is-active" aria-current="page"{% endif %}>{{ item.title }}</a>
    {% endif %}
  {% endfor %}
{% endmacro %}
