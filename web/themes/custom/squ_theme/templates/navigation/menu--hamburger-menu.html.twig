{% import _self as menus %}
{% if items %}
  {{ menus.drawer_links(items) }}
{% endif %}

{% macro drawer_links(items) %}
  {% import _self as menus %}
  {% for item in items %}
    {% if item.below %}
      <details class="drawer-group"{% if item.in_active_trail %} open{% endif %}>
        <summary>{{ item.title }}</summary>
        <div class="drawer-sub">
          <a href="{{ item.url }}"{% if item.in_active_trail %} aria-current="page"{% endif %}>{{ item.title }}</a>
          {{ menus.drawer_links(item.below) }}
        </div>
      </details>
    {% else %}
      <a href="{{ item.url }}"{% if item.in_active_trail %} aria-current="page"{% endif %}>{{ item.title }}</a>
    {% endif %}
  {% endfor %}
{% endmacro %}
