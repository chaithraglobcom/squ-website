{% import _self as menus %}
{% if items %}
  <nav class="primary-nav primary-nav--header-links" aria-label="{{ 'Header quick links'|t }}">
    {{ menus.links(items) }}
  </nav>
{% endif %}

{% macro links(items) %}
  {% import _self as menus %}
  {% for item in items %}
    {% if item.below %}
      <div class="primary-nav__item has-children">
        <a href="{{ item.url }}"{% if item.in_active_trail %} class="is-active" aria-current="page"{% endif %}>{{ item.title }}</a>
        <div class="primary-nav__sub">
          {{ menus.links(item.below) }}
        </div>
      </div>
    {% else %}
      <a href="{{ item.url }}"{% if item.in_active_trail %} class="is-active" aria-current="page"{% endif %}>{{ item.title }}</a>
    {% endif %}
  {% endfor %}
{% endmacro %}
